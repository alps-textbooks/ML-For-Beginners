    "<exercise label=\"mlb-quiz-1-1-pre-2\">\n",
    "  <statement>\n",
    "    <p>What is the technical difference between classical ML and deep learning?</p>\n",
    "  </statement>\n",
    "  <choices randomize=\"no\">\n",
    "    <choice>\n",
    "      <statement>\n",
    "        <p>classical ML was invented first</p>\n",
    "      </statement>\n",
    "    </choice>\n",
    "    <choice correct=\"yes\">\n",
    "      <statement>\n",
    "        <p>the use of neural networks</p>\n",
    "      </statement>\n",
    "    </choice>\n",
    "    <choice>\n",
    "      <statement>\n",
    "        <p>deep learning is used in robots</p>\n",
    "      </statement>\n",
    "    </choice>\n",
    "  </choices>\n",
    "</exercise>"
