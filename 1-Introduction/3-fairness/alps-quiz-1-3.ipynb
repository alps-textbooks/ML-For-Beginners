    "    <choice>\n",
    "      <statement>\n",
    "        <p>intentionally</p>\n",
    "      </statement>\n",
    "    </choice>\n",
    "    <choice>\n",
    "      <statement>\n",
    "        <p>unintentionally</p>\n",
    "      </statement>\n",
    "    </choice>\n",
    "    <choice correct=\"yes\">\n",
    "      <statement>\n",
    "        <p>both of the above</p>\n",
    "      </statement>\n",
    "    </choice>\n",
    "  </choices>\n",
    "</exercise>"
   ]
