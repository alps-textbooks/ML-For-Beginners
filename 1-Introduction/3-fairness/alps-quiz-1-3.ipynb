    "format": "application/vnd.pretext+xml"
   },
   "source": [
    "<exercise label=\"mlb-quiz-1-3-pre-3\">\n",
    "  <statement>\n",
    "    <p>The five main types of harms include</p>\n",
    "  </statement>\n",
    "  <choices randomize=\"no\">\n",
    "    <choice correct=\"yes\">\n",
    "      <statement>\n",
    "        <p>allocation, quality of service, stereotyping, denigration, and over- or under- representation</p>\n",
    "      </statement>\n",
    "    </choice>\n",
    "    <choice>\n",
    "      <statement>\n",
    "        <p>elocation, quality of service, stereotyping, denigration, and over- or under- representation</p>\n",
    "      </statement>\n",
    "    </choice>\n",
    "    <choice>\n",
    "      <statement>\n",
    "        <p>allocation, quality of service, stereophonics, denigration, and over- or under- representation</p>\n",
    "      </statement>\n",
    "    </choice>\n",
    "  </choices>\n",
    "</exercise>"
   ]
