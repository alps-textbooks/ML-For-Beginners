    "  <choices randomize=\"no\">\n",
    "    <choice>\n",
    "      <statement>\n",
    "        <p>1980s</p>\n",
    "      </statement>\n",
    "    </choice>\n",
    "    <choice correct=\"yes\">\n",
    "      <statement>\n",
    "        <p>1950s</p>\n",
    "      </statement>\n",
    "    </choice>\n",
    "    <choice>\n",
    "      <statement>\n",
    "        <p>1930s</p>\n",
    "      </statement>\n",
    "    </choice>\n",
