   },
   "source": [
    "<exercise label=\"mlb-quiz-6-1-post-3\">\n",
    "  <statement>\n",
    "    <p>How would you make the bot more effective?</p>\n",
    "  </statement>\n",
    "  <choices randomize=\"no\">\n",
    "    <choice>\n",
    "      <statement>\n",
    "        <p>By asking it more questions.</p>\n",
    "      </statement>\n",
    "    </choice>\n",
    "    <choice correct=\"yes\">\n",
    "      <statement>\n",
    "        <p>By feeding it more data and training it accordingly</p>\n",
    "      </statement>\n",
    "    </choice>\n",
    "    <choice>\n",
    "      <statement>\n",
    "        <p>The bot is dumb, it cannot learn :(</p>\n",
    "      </statement>\n",
    "    </choice>\n",
    "  </choices>\n",
    "</exercise>"
   ]
