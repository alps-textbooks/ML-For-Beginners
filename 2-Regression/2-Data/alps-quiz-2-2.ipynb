    "<exercise label=\"mlb-quiz-2-2-post-1\">\n",
    "  <statement>\n",
    "    <p>Which of these code snippets is correct based on this lesson, if you want to check for the presence of missing values in your dataset? Suppose the dataset is stored in a variable named 'dataset' which is a Pandas DataFrame object.</p>\n",
    "  </statement>\n",
    "  <choices randomize=\"no\">\n",
    "    <choice correct=\"yes\">\n",
    "      <statement>\n",
    "        <p>dataset.isnull().sum()</p>\n",
    "      </statement>\n",
    "    </choice>\n",
    "    <choice>\n",
    "      <statement>\n",
    "        <p>findMissing(dataset)</p>\n",
    "      </statement>\n",
    "    </choice>\n",
    "    <choice>\n",
    "      <statement>\n",
    "        <p>sum(null(dataset))</p>\n",
    "      </statement>\n",
    "    </choice>\n",
    "  </choices>\n",
    "</exercise>"
   ]
  },
  {
   "cell_type": "raw",
