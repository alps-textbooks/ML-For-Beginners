    "    <choice>\n",
    "      <statement>\n",
    "        <p>electrical engineering</p>\n",
    "      </statement>\n",
    "    </choice>\n",
    "    <choice correct=\"yes\">\n",
    "      <statement>\n",
    "        <p>signal processing</p>\n",
    "      </statement>\n",
    "    </choice>\n",
    "    <choice>\n",
    "      <statement>\n",
    "        <p>computational linguistics</p>\n",
    "      </statement>\n",
    "    </choice>\n",
    "  </choices>\n",
    "</exercise>"
   ]
  },
  {
   "cell_type": "raw",
   "metadata": {
    "format": "application/vnd.pretext+xml"
   },
   "source": [
    "<exercise label=\"mlb-quiz-5-2-pre-2\">\n",
    "  <statement>\n",
    "    <p>A good Silhouette score means:</p>\n",
    "  </statement>\n",
    "  <choices randomize=\"no\">\n",
    "    <choice correct=\"yes\">\n",
    "      <statement>\n",
    "        <p>clusters are well-separated and well-defined</p>\n",
    "      </statement>\n",
    "    </choice>\n",
    "    <choice>\n",
    "      <statement>\n",
    "        <p>there are few clusters</p>\n",
    "      </statement>\n",
    "    </choice>\n",
    "    <choice>\n",
    "      <statement>\n",
    "        <p>there are many clusters</p>\n",
    "      </statement>\n",
    "    </choice>\n",
    "  </choices>\n",
    "</exercise>"
   ]
  },
  {
   "cell_type": "raw",
   "metadata": {
    "format": "application/vnd.pretext+xml"
   },
   "source": [
    "<exercise label=\"mlb-quiz-5-2-pre-3\">\n",
    "  <statement>\n",
    "    <p>Variance is:</p>\n",
    "  </statement>\n",
    "  <choices randomize=\"no\">\n",
    "    <choice>\n",
    "      <statement>\n",
    "        <p>the average of the squared differences from the mean</p>\n",
    "      </statement>\n",
    "    </choice>\n",
    "    <choice>\n",
    "      <statement>\n",
    "        <p>a problem for clustering if it becomes too high</p>\n",
    "      </statement>\n",
    "    </choice>\n",
    "    <choice correct=\"yes\">\n",
    "      <statement>\n",
    "        <p>both of these</p>\n",
    "      </statement>\n",
    "    </choice>\n",
    "  </choices>\n",
    "</exercise>"
   ]
  },
  {
